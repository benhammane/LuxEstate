// LuxEstate — Prisma schema (PostgreSQL)
// Normalised, indexed and ready for migrations. Auth.js models included.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ //
// Enums
// ------------------------------------------------------------------ //

enum UserRole {
  CLIENT
  AGENT
  ADMIN
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  VILLA
  APARTMENT
  PENTHOUSE
  HOUSE
  CHALET
  LOFT
  MANSION
  LAND
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  SOLD
  RENTED
  ARCHIVED
}

enum EnergyRating {
  A
  B
  C
  D
  E
  F
  G
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  APPOINTMENT
  MESSAGE
  FAVORITE
  SYSTEM
}

// ------------------------------------------------------------------ //
// Auth & users
// ------------------------------------------------------------------ //

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  role          UserRole  @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  agent         Agent?
  favorites     Favorite[]
  savedSearches SavedSearch[]
  appointments  Appointment[]
  reviews       Review[]
  messages      Message[]
  notifications Notification[]
  logs          Log[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------------ //
// RBAC (fine-grained, optional on top of UserRole)
// ------------------------------------------------------------------ //

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "property.create"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
}

// ------------------------------------------------------------------ //
// Agents
// ------------------------------------------------------------------ //

model Agent {
  id        String   @id @default(cuid())
  userId    String   @unique
  slug      String   @unique
  title     String? // e.g. "Directrice, Côte d'Azur"
  bio       String?
  phone     String?
  photo     String?
  languages String[] @default([])
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties   Property[]
  appointments Appointment[]
}

// ------------------------------------------------------------------ //
// Geography & taxonomy
// ------------------------------------------------------------------ //

model City {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  region    String?
  country   String     @default("France")
  latitude  Float?
  longitude Float?
  districts District[]
  properties Property[]

  @@index([slug])
}

model District {
  id         String     @id @default(cuid())
  name       String
  slug       String
  cityId     String
  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([cityId, slug])
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  properties Property[]
}

model Amenity {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  icon       String?
  properties PropertyAmenity[]
}

// ------------------------------------------------------------------ //
// Properties
// ------------------------------------------------------------------ //

model Property {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String
  listingType ListingType
  type        PropertyType
  status      PropertyStatus @default(DRAFT)

  price      Int // in cents avoided for demo; whole currency units
  currency   String  @default("EUR")
  surface    Int // m²
  landSize   Int? // m²
  bedrooms   Int     @default(0)
  bathrooms  Int     @default(0)
  floors     Int?
  yearBuilt  Int?
  energyRating EnergyRating?

  // Location
  address   String?
  postalCode String?
  latitude  Float
  longitude Float

  featured     Boolean @default(false)
  confidential Boolean @default(false) // off-market
  views        Int     @default(0)

  cityId     String
  districtId String?
  categoryId String?
  agentId    String?

  city       City              @relation(fields: [cityId], references: [id])
  district   District?         @relation(fields: [districtId], references: [id])
  category   Category?         @relation(fields: [categoryId], references: [id])
  agent      Agent?            @relation(fields: [agentId], references: [id])
  images     PropertyImage[]
  amenities  PropertyAmenity[]
  favorites  Favorite[]
  reviews    Review[]
  appointments Appointment[]
  messages   Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?

  @@index([status, listingType])
  @@index([cityId])
  @@index([price])
  @@index([type])
  @@index([featured])
  @@index([latitude, longitude])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  position   Int      @default(0)
  isCover    Boolean  @default(false)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

// ------------------------------------------------------------------ //
// User activity
// ------------------------------------------------------------------ //

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     Json // serialised filter state
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Appointment {
  id         String            @id @default(cuid())
  userId     String
  propertyId String
  agentId    String?
  scheduledAt DateTime
  status     AppointmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent    Agent?   @relation(fields: [agentId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([scheduledAt])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  rating     Int // 1..5
  comment    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Message {
  id         String   @id @default(cuid())
  userId     String? // null for anonymous contact form
  propertyId String?
  name       String
  email      String
  phone      String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([read])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ------------------------------------------------------------------ //
// CMS / platform
// ------------------------------------------------------------------ //

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}
