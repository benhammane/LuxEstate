# ------------------------------------------------------------------ #
# LuxEstate — environment variables
# Copy to `.env` and fill in. The app runs on demo data without these.
# ------------------------------------------------------------------ #

# Public site URL (used for SEO/OpenGraph/canonical)
NEXT_PUBLIC_SITE_URL="http://localhost:3400"

# Database (Supabase / PostgreSQL). Required only for Prisma-backed data.
DATABASE_URL="postgresql://user:password@localhost:5432/luxestate?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Map — optional Mapbox token. Falls back to free MapLibre/CARTO tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Public — used by the admin drag & drop uploader (unsigned upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM="LuxEstate <hello@luxestate.demo>"
CONTACT_INBOX="leads@luxestate.fr"
